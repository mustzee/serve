# Example environment configuration
# Copy this to .env and modify as needed

# Server settings
LLM_HOST=0.0.0.0
LLM_PORT=8000
LLM_WORKERS=1

# Backend configuration
LLM_BACKEND_TYPE=ollama
LLM_DEFAULT_MODEL=llama2

# Ollama settings
LLM_OLLAMA_BASE_URL=http://localhost:11434

# llama.cpp settings (uncomment if using)
# LLM_LLAMACPP_MODEL_PATH=/models
# LLM_LLAMACPP_N_CTX=4096
# LLM_LLAMACPP_N_GPU_LAYERS=0

# vLLM settings (uncomment if using)
# LLM_VLLM_MODEL_PATH=/models/llama-2-7b
# LLM_VLLM_TENSOR_PARALLEL_SIZE=1
# LLM_VLLM_DTYPE=auto

# Model cache
LLM_MODEL_CACHE_DIR=./model_cache
